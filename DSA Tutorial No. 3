Program 2: (Selection Sort)
#include <stdio.h>
void bs(int a[], int n) {
    int i, j, min, t;
    for(i=0; i<n-1; i++) {
        min=i;
        for(j=i+1; j<n; j++)
            if(a[j]<a[min]) min=j;
        t=a[i]; a[i]=a[min]; a[min]=t;
    }
}
int main() {
    int a[]={5,3,4,1,2}, i;
    bs(a,5);
    for(i=0;i<5;i++)
        printf("%d ",a[i]);
    return 0;
}
