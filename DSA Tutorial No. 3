Program 1: (Bubble Sort)
#include <stdio.h>
int main() {
    int a[] = {5, 3, 4, 1, 2}, n = 5, i, j, t;
    for(i = 0; i < n-1; i++)
        for(j = 0; j < n-i-1; j++)
            if(a[j] > a[j+1]) {
                t = a[j];
                a[j] = a[j+1];
                a[j+1] = t;
            }
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);
    return 0;
}
