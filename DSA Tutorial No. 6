#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *next;
};
struct node *top = NULL;

void push(int x) {
    struct node *n = malloc(sizeof(struct node));
    n->data = x;
    n->next = top;
    top = n;
}

void pop() {
    if (top == NULL)
        printf("Underflow");
    else {
        printf("Popped %d", top->data);
        top = top->next;
    }
}

int main() {
    push(10);
    push(20);
    push(30);
    pop();
    return 0;
}
