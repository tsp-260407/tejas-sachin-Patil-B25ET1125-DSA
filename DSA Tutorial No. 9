#include <stdio.h>

int main()
{
    int a[10][10], v[10] = {0};
    int n, i, j, min, u = 0, w = 0;
    int cost = 0, edges = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
        {
            scanf("%d", &a[i][j]);
            if(a[i][j] == 0 && i != j)
                a[i][j] = 999;
        }

    v[0] = 1;
    printf("\nMinimum Spanning Tree:\n");

    while(edges < n - 1)
    {
        min = 999;

        for(i = 0; i < n; i++)
            if(v[i])
                for(j = 0; j < n; j++)
                    if(!v[j] && a[i][j] < min)
                    {
                        min = a[i][j];
                        u = i;
                        w = j;
                    }
        if(min == 999)
        {
            printf("MST not possible\n");
            return 0;
        }

        printf("%d - %d = %d\n", u+1, w+1, min);
        cost += min;
        v[w] = 1;
        edges++;
    }
    printf("Minimum cost = %d\n", cost);

    return 0;
}
