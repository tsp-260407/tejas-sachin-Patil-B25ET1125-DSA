#include <stdio.h>
#include <string.h>

void reverse(char str[]) {
    int i, j;
    char temp;

    for (i = 0, j = strlen(str) - 1; i < j; i++, j--) {
        temp = str[i];
        str[i] = str[j];
        str[j] = temp;
    }
}

int main() {
    int choice, pos, len, i;
    char str1[100], str2[100], temp[100], sub[100];

    printf("=== String Operations Menu ===\n");
    printf("1. Substring Extraction\n");
    printf("2. Palindrome Check\n");
    printf("3. Compare Two Strings\n");
    printf("4. Copy a String\n");
    printf("5. Reverse a String\n");
    printf("Enter your choice (1-5): ");
    scanf("%d", &choice);
    getchar();

    switch (choice) {

        case 1:
            printf("Enter a string: ");
            fgets(str1, sizeof(str1), stdin);
            str1[strcspn(str1, "\n")] = '\0';

            printf("Enter starting index and length: ");
            scanf("%d %d", &pos, &len);

            if (pos >= 0 && pos < strlen(str1) && len >= 0) {
                for (i = 0; i < len && str1[pos + i] != '\0'; i++)
                    sub[i] = str1[pos + i];

                sub[i] = '\0';

                printf("Resulting substring: %s\n", sub);
            } else {
                printf("Invalid starting index or length!\n");
            }
            break;

        case 2:
            printf("Enter a string to check: ");
            fgets(str1, sizeof(str1), stdin);
            str1[strcspn(str1, "\n")] = '\0';

            strcpy(temp, str1);
            reverse(temp);

            if (strcmp(str1, temp) == 0)
                printf("\"%s\" is a palindrome.\n", str1);
            else
                printf("\"%s\" is not a palindrome.\n", str1);

            break;

        case 3:
            printf("Enter first string: ");
            fgets(str1, sizeof(str1), stdin);
            str1[strcspn(str1, "\n")] = '\0';

            printf("Enter second string: ");
            fgets(str2, sizeof(str2), stdin);
            str2[strcspn(str2, "\n")] = '\0';

            if (strcmp(str1, str2) == 0)
                printf("Both strings are completely identical.\n");
            else if (strcmp(str1, str2) > 0)
                printf("The first string comes after the second alphabetically.\n");
            else
                printf("The first string comes before the second alphabetically.\n");

            break;

        case 4:
            printf("Enter the source string to copy: ");
            fgets(str1, sizeof(str1), stdin);
            str1[strcspn(str1, "\n")] = '\0';

            strcpy(str2, str1);

            printf("Source string: %s\n", str1);
            printf("Copied target string: %s\n", str2);

            break;

        case 5:
            printf("Enter a string to reverse: ");
            fgets(str1, sizeof(str1), stdin);
            str1[strcspn(str1, "\n")] = '\0';

            reverse(str1);

            printf("Reversed string: %s\n", str1);

            break;

        default:
            printf("Invalid selection! Enter a number between 1 and 5.\n");
    }

    return 0;
}
